# Copie para .env e preencha com os valores reais.
# Nunca comite o .env preenchido.

# Web: http://localhost:8091
# API: http://localhost:8092

# Telegram — token do @BotFather
TELEGRAM_BOT_TOKEN=
GROQ_API_KEY=

# Modelos da Groq
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_WHISPER_MODEL=whisper-large-v3

# PostgreSQL
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# Sessão do painel
# Gere com: openssl rand -hex 32
JWT_SECRET=
JWT_EXPIRE_MINUTES=5

# Administrador criado na primeira subida do backend
ADMIN_EMAIL=
ADMIN_PASSWORD=
